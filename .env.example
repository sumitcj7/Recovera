NODE_ENV=development
PORT=8000
MONGODB_URI=mongodb://localhost:27018/recovera
REDIS_URL=redis://localhost:6379

APP_KEY_PEPPER=generate-a-unique-secret-before-starting-the-engine
BACKUP_STORAGE_ROOT=./backups
LOG_LEVEL=info
MONGODB_RESTORE_IMAGE=mongo:8
VERIFICATION_CONCURRENCY=1
VERIFICATION_ATTEMPTS=2
VERIFICATION_TIMEOUT_MS=900000
STUCK_JOB_THRESHOLD_MS=1800000
RESTORE_MEMORY_BYTES=1073741824
RESTORE_CPU_NANO=1000000000
RESTORE_PIDS_LIMIT=256
# Set a stable unique value only when running a dedicated standalone worker.
# Embedded workers generate a process-local ID.
WORKER_ID=
RUN_VERIFICATION_WORKER=true
