NODE_ENV=development
PORT=8000
MONGODB_URI=mongodb://localhost:27017/recovera
REDIS_URL=redis://localhost:6379
APP_KEY_PEPPER=replace-with-a-long-random-secret
BACKUP_STORAGE_ROOT=/var/lib/recovera/backups
LOG_LEVEL=info
MONGODB_RESTORE_IMAGE=mongo:8
VERIFICATION_CONCURRENCY=1
VERIFICATION_ATTEMPTS=2
VERIFICATION_TIMEOUT_MS=900000
RESTORE_MEMORY_BYTES=1073741824
RESTORE_CPU_NANO=1000000000
